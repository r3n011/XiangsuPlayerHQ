    <!-- BetaInfoBottomSheet -->
    <string name="beta_sheet_version">Bêta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Bienvenue dans XiangsuPlayer 0.7.5-bêta</string>
    <string name="beta_sheet_welcome_body">Vous utilisez une version bêta qui peut contenir des bugs, des plantages ou des fonctionnalités expérimentales. Aidez-nous à l\'améliorer en signalant les problèmes.</string>
    <string name="beta_sheet_expect_title">À quoi s\'attendre</string>
    <string name="beta_sheet_expect_1">Des bugs, plantages ou fonctionnalités incomplètes peuvent survenir de manière inattendue.</string>
    <string name="beta_sheet_expect_2">Certaines fonctionnalités peuvent changer ou être supprimées sans préavis.</string>
    <string name="beta_sheet_expect_3">Les versions bêta peuvent être plus instables que les versions stables.</string>
    <string name="beta_sheet_expect_4">Vérifiez toujours les mises à jour avant de signaler un problème connu.</string>
    <string name="beta_sheet_expect_summary">Ce que les versions bêta peuvent changer, casser ou améliorer pendant les tests.</string>
    <string name="beta_sheet_github_title">Raccourci vers les tickets GitHub</string>
    <string name="beta_sheet_github_body">Recherchez d\'abord, puis ouvrez un ticket ciblé pour les bugs, plantages, demandes ou questions.</string>
    <string name="beta_sheet_open_issues">Ouvrir les tickets existants</string>
    <string name="beta_sheet_report_bug">Signaler un problème ou un plantage</string>
    <string name="beta_sheet_report_body">Partagez les étapes de reproduction, les résultats attendus, les résultats réels et les détails de votre appareil/système.</string>
    <string name="beta_sheet_report_title">Comment signaler</string>
    <string name="beta_sheet_report_summary">Une liste rapide à vérifier avant d\'ouvrir un nouveau ticket.</string>
    <string name="beta_sheet_before_title">Avant d\'ouvrir un ticket</string>
    <string name="beta_sheet_before_1">Recherchez les tickets ouverts et fermés existants pour éviter les doublons.</string>
    <string name="beta_sheet_before_2">Mettez à jour XiangsuPlayer vers la dernière version et vérifiez que le problème persiste.</string>
    <string name="beta_sheet_before_3">Redémarrez l\'application et vérifiez que le problème persiste.</string>
    <string name="beta_sheet_before_4">Essayez de le reproduire et notez les étapes exactes.</string>
    <string name="beta_sheet_issue_type_title">Quel type de ticket ?</string>
    <string name="beta_sheet_issue_type_bug">Rapport de bug : quelque chose se comporte mal.</string>
    <string name="beta_sheet_issue_type_feature">Demande de fonctionnalité : ajouter une fonctionnalité ou une amélioration.</string>
    <string name="beta_sheet_issue_type_question">Question : utilisez les Discussions si elles sont activées, ou ouvrez un ticket avec l\'étiquette question.</string>
    <string name="beta_sheet_bug_title">Signalement de bug</string>
    <string name="beta_sheet_bug_summary_text">Copiez ces champs lorsqu\'un comportement est incorrect ou qu\'une application plante.</string>
    <string name="beta_sheet_bug_template_title">Rapport de bug</string>
    <string name="beta_sheet_bug_summary">Résumé court :</string>
    <string name="beta_sheet_bug_expected">Comportement attendu :</string>
    <string name="beta_sheet_bug_actual">Comportement actuel :</string>
    <string name="beta_sheet_bug_steps">Étapes pour lire/reproduire : 1. 2. 3.</string>
    <string name="beta_sheet_bug_frequency">À quelle fréquence cela se produit-il ? Toujours / Parfois / Rarement.</string>
    <string name="beta_sheet_bug_screenshot">Capture d\'écran / vidéo : si disponible.</string>
    <string name="beta_sheet_bug_logs">Journaux / trace de pile : si disponibles.</string>
    <string name="beta_sheet_env_title">Environnement</string>
    <string name="beta_sheet_env_version">Version de XiangsuPlayer :</string>
    <string name="beta_sheet_env_source">Source d\'installation : GitHub Release, version debug, version nightly, etc.</string>
    <string name="beta_sheet_env_android">Version d\'Android :</string>
    <string name="beta_sheet_env_device">Modèle de l\'appareil :</string>
    <string name="beta_sheet_env_extra">Contexte supplémentaire : utilisation d\'une carte SD, réglages spéciaux, autorisations, etc.</string>
    <string name="beta_sheet_feature_title">Demande de fonctionnalité</string>
    <string name="beta_sheet_feature_summary">Copiez ces champs lorsque vous souhaitez une nouvelle fonctionnalité ou une amélioration.</string>
    <string name="beta_sheet_feature_problem">Énoncé du problème : quel problème essayez-vous de résoudre ?</string>
    <string name="beta_sheet_feature_solution">Solution proposée : comment cela devrait-il fonctionner ?</string>
    <string name="beta_sheet_feature_alternatives">Alternatives envisagées : d\'autres approches ?</string>
    <string name="beta_sheet_feature_scope">Périmètre : quels écrans ou parcours sont concernés ?</string>
    <string name="beta_sheet_feature_mockup">Maquette ou image de référence si disponible.</string>
    <string name="beta_sheet_quality_title">Titres, confidentialité et périmètre</string>
    <string name="beta_sheet_quality_summary">Rendez le rapport facile à trier et sûr à partager.</string>
    <string name="beta_sheet_title_examples_title">Bons titres de tickets</string>
    <string name="beta_sheet_title_example_1">Égaliseur : l\'indicateur se décale lors du changement d\'onglet de préréglage</string>
    <string name="beta_sheet_title_example_2">Recherche : l\'historique ne s\'affiche pas pour une requête vide</string>
    <string name="beta_sheet_title_example_3">Fonctionnalité : ajouter l\'option de tri « Ajoutés récemment » aux playlists</string>
    <string name="beta_sheet_avoid_title">À éviter</string>
    <string name="beta_sheet_avoid_1">Les signalements génériques comme « ça ne marche pas ».</string>
    <string name="beta_sheet_avoid_2">Plusieurs problèmes sans rapport dans un même ticket.</string>
    <string name="beta_sheet_avoid_3">Journaux ou captures d\'écran non masqués contenant des données privées.</string>
    <string name="beta_sheet_privacy_title">Note de confidentialité</string>
    <string name="beta_sheet_privacy_body">Avant de publier des journaux, captures d\'écran ou vidéos, supprimez les informations personnelles ou privées.</string>
    <string name="beta_sheet_nightly_title">Versions nightly</string>
    <string name="beta_sheet_nightly_summary">En quoi les versions nightly diffèrent des versions stables, et quoi inclure lorsqu\'elles dysfonctionnent.</string>
    <string name="beta_sheet_nightly_body">Les versions nightly sont générées à partir du dernier commit et peuvent contenir des modifications inachevées, des bugs temporaires ou des régressions. Elles sont plus expérimentales que les versions officielles.</string>
    <string name="beta_sheet_nightly_access">Accédez-y depuis les artefacts du workflow GitHub Actions du dépôt s\'ils sont disponibles.</string>
    <string name="beta_sheet_nightly_report_title">Signaler un problème d\'une version nightly</string>
    <string name="beta_sheet_nightly_report_body">Lorsque vous signalez un problème issu d\'une version nightly, précisez toujours qu\'il s\'est produit sur une version nightly et non sur la version officielle. Indiquez la date de compilation, le nom ou le numéro d\'exécution du workflow, ou le SHA du commit si possible. Vérifiez aussi si le même problème se produit sur la dernière version officielle.</string>
    <string name="beta05_title">Mise à niveau vers la bêta 0.5.0</string>
    <string name="beta05_clean_install_title">Installation propre recommandée</string>
    <string name="beta05_clean_install_body">Si vous venez de la bêta 0.5.0, cette mise à jour peut nécessiter des données de bibliothèque actualisées plutôt que l\'ancien état mis en cache.</string>
    <string name="beta05_if_wrong_meta_title">Si les métadonnées ou les entrées de la bibliothèque semblent incorrectes</string>
    <string name="beta05_if_wrong_meta_body">Des métadonnées incorrectes, des artistes ou albums mal associés, ou des entrées qui semblent en double signifient souvent qu\'une installation propre s\'impose.</string>
    <string name="beta05_dont_show">Ne plus afficher</string>
    <string name="beta05_got_it">Compris</string>

