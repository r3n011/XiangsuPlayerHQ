    <string name="beta_sheet_version">Beta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Willkommen bei XiangsuPlayer 0.7.5-beta</string>
    <string name="beta_sheet_welcome_body">Du verwendest einen Beta-Build, der Fehler, Abstürze oder experimentelle Funktionen enthalten kann. Hilf uns, indem du Probleme meldest.</string>
    <string name="beta_sheet_expect_title">Was dich erwartet</string>
    <string name="beta_sheet_expect_1">Fehler, Abstürze oder unfertige Funktionen können unerwartet auftreten.</string>
    <string name="beta_sheet_expect_2">Einige Funktionen können sich ohne Vorankündigung ändern oder entfernt werden.</string>
    <string name="beta_sheet_expect_3">Beta-Builds können instabiler sein als Release-Versionen.</string>
    <string name="beta_sheet_expect_4">Prüfe vor dem Melden eines bekannten Problems immer auf Updates.</string>
    <string name="beta_sheet_expect_summary">Was Beta-Builds beim Testen ändern, kaputt machen oder verbessern können.</string>
    <string name="beta_sheet_github_title">GitHub-Issue-Verknüpfung</string>
    <string name="beta_sheet_github_body">Suche zuerst und eröffne dann einen gezielten Bericht für Fehler, Abstürze, Wünsche oder Fragen.</string>
    <string name="beta_sheet_open_issues">Bestehende Issues öffnen</string>
    <string name="beta_sheet_report_bug">Problem oder Absturz melden</string>
    <string name="beta_sheet_report_body">Nenne Schritte zur Reproduktion, erwartetes und tatsächliches Ergebnis sowie Angaben zu Gerät und Betriebssystem.</string>
    <string name="beta_sheet_report_title">So meldest du</string>
    <string name="beta_sheet_report_summary">Eine kurze Checkliste, bevor du ein neues Issue eröffnest.</string>
    <string name="beta_sheet_before_title">Bevor du ein Issue eröffnest</string>
    <string name="beta_sheet_before_1">Suche in bestehenden offenen und geschlossenen Issues, um Doppelte zu vermeiden.</string>
    <string name="beta_sheet_before_2">Aktualisiere auf die neueste XiangsuPlayer-Version und prüfe, ob das Problem weiterhin auftritt.</string>
    <string name="beta_sheet_before_3">Starte die App neu und prüfe, ob das Problem weiterhin besteht.</string>
    <string name="beta_sheet_before_4">Versuche, es zu reproduzieren, und notiere die genauen Schritte.</string>
    <string name="beta_sheet_issue_type_title">Welcher Issue-Typ?</string>
    <string name="beta_sheet_issue_type_bug">Bugreport: Etwas verhält sich falsch.</string>
    <string name="beta_sheet_issue_type_feature">Funktionswunsch: Eine neue Funktion oder Verbesserung hinzufügen.</string>
    <string name="beta_sheet_issue_type_question">Frage: Nutze Discussions, falls aktiviert, oder eröffne ein Issue mit dem Label „Frage“.</string>
    <string name="beta_sheet_bug_title">Bugreport</string>
    <string name="beta_sheet_bug_summary_text">Kopiere diese Felder, wenn sich etwas falsch verhält oder abstürzt.</string>
