<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night theme - WITHOUT DynamicColors (compatible with Android 7+) -->
    <style name="Theme.PixelPlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 与 values/themes.xml 的 Theme.App.Starting 保持一致（DayNight 基类自动解析暗色背景） -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PixelPlay</item>
    </style>
</resources>
