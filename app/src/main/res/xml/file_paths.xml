<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This allows sharing files from cacheDir -->
    <cache-path
        name="cache"
        path="." />
    <files-path
        name="files"
        path="." />
    <!-- Allows sharing downloaded update APKs from public Downloads -->
    <external-path
        name="downloads"
        path="Download/" />
    <external-files-path
        name="external_files"
        path="." />
</paths>
