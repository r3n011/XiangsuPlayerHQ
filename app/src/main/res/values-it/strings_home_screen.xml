    <!-- BetaInfoBottomSheet -->
    <string name="beta_sheet_version">Beta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Benvenuto in XiangsuPlayer 0.7.5-beta</string>
    <string name="beta_sheet_welcome_body">Stai usando una build beta che può contenere bug, crash o funzionalità sperimentali. Aiutaci a migliorare segnalando i problemi.</string>
    <string name="beta_sheet_expect_title">Cosa aspettarsi</string>
    <string name="beta_sheet_expect_1">Possono verificarsi bug, crash o funzionalità incomplete in modo imprevisto.</string>
    <string name="beta_sheet_expect_2">Alcune funzionalità possono cambiare o essere rimosse senza preavviso.</string>
    <string name="beta_sheet_expect_3">Le build beta possono essere più instabili delle versioni di rilascio.</string>
    <string name="beta_sheet_expect_4">Controlla sempre gli aggiornamenti prima di segnalare un problema noto.</string>
    <string name="beta_sheet_expect_summary">Cosa possono cambiare, rompere o migliorare le build beta durante i test.</string>
    <string name="beta_sheet_github_title">Scorciatoia issue GitHub</string>
    <string name="beta_sheet_github_body">Cerca prima, poi apri una segnalazione mirata per bug, crash, richieste o domande.</string>
    <string name="beta_sheet_open_issues">Apri le issue esistenti</string>
    <string name="beta_sheet_report_bug">Segnala problema o crash</string>
    <string name="beta_sheet_report_body">Condividi i passaggi per riprodurre il problema, i risultati attesi, quelli effettivi e i dettagli del dispositivo e del sistema operativo.</string>
    <string name="beta_sheet_report_title">Come segnalare</string>
    <string name="beta_sheet_report_summary">Una rapida checklist prima di aprire una nuova issue.</string>
    <string name="beta_sheet_before_title">Prima di aprire una issue</string>
    <string name="beta_sheet_before_1">Cerca tra le issue aperte e chiuse esistenti per evitare duplicati.</string>
    <string name="beta_sheet_before_2">Aggiorna all\'ultima versione di XiangsuPlayer e verifica che il problema si presenti ancora.</string>
    <string name="beta_sheet_before_3">Riavvia l\'app e verifica che il problema persista.</string>
    <string name="beta_sheet_before_4">Prova a riprodurlo e annota i passaggi esatti.</string>
    <string name="beta_sheet_issue_type_title">Quale tipo di issue?</string>
    <string name="beta_sheet_issue_type_bug">Segnalazione bug: qualcosa non funziona correttamente.</string>
    <string name="beta_sheet_issue_type_feature">Richiesta funzionalità: aggiungi una nuova funzione o un miglioramento.</string>
    <string name="beta_sheet_issue_type_question">Domanda: usa le Discussioni se disponibili, oppure apri una issue con l\'etichetta domanda.</string>
    <string name="beta_sheet_bug_title">Segnalazione bug</string>
    <string name="beta_sheet_bug_summary_text">Copia questi campi quando qualcosa non funziona correttamente o va in crash.</string>
    <string name="beta_sheet_bug_template_title">Segnalazione bug</string>
    <string name="beta_sheet_bug_summary">Breve riepilogo:</string>
    <string name="beta_sheet_bug_expected">Comportamento previsto:</string>
    <string name="beta_sheet_bug_actual">Comportamento attuale:</string>
    <string name="beta_sheet_bug_steps">Passaggi per riprodurre: 1. 2. 3.</string>
    <string name="beta_sheet_bug_frequency">Con quale frequenza accade? Sempre / A volte / Raramente.</string>
    <string name="beta_sheet_bug_screenshot">Screenshot / video: se disponibili.</string>
    <string name="beta_sheet_bug_logs">Log / stack trace: se disponibili.</string>
    <string name="beta_sheet_env_title">Ambiente</string>
    <string name="beta_sheet_env_version">Versione XiangsuPlayer:</string>
    <string name="beta_sheet_env_source">Origine installazione: GitHub Release, build di debug, build nightly, ecc.</string>
    <string name="beta_sheet_env_android">Versione Android:</string>
    <string name="beta_sheet_env_device">Modello dispositivo:</string>
    <string name="beta_sheet_env_extra">Contesto aggiuntivo: uso della scheda SD, impostazioni particolari, autorizzazioni, ecc.</string>
    <string name="beta_sheet_feature_title">Richiesta funzionalità</string>
    <string name="beta_sheet_feature_summary">Copia questi campi quando desideri una nuova funzionalità o un miglioramento.</string>
    <string name="beta_sheet_feature_problem">Descrizione del problema: quale problema stai cercando di risolvere?</string>
    <string name="beta_sheet_feature_solution">Soluzione proposta: come dovrebbe funzionare?</string>
    <string name="beta_sheet_feature_alternatives">Alternative considerate: altre soluzioni possibili?</string>
    <string name="beta_sheet_feature_scope">Ambito: quali schermate o flussi sono coinvolti?</string>
    <string name="beta_sheet_feature_mockup">Mockup o immagine di riferimento, se disponibile.</string>
    <string name="beta_sheet_quality_title">Titoli, privacy e ambito</string>
    <string name="beta_sheet_quality_summary">Rendi la segnalazione facile da valutare e sicura da condividere.</string>
    <string name="beta_sheet_title_examples_title">Titoli efficaci per le issue</string>
    <string name="beta_sheet_title_example_1">Equalizzatore: l\'indicatore si sposta cambiando le schede dei preset</string>
    <string name="beta_sheet_title_example_2">Ricerca: l\'elenco della cronologia non appare con una query vuota</string>
    <string name="beta_sheet_title_example_3">Funzionalità: aggiungi l\'opzione di ordinamento «Aggiunti di recente» per le playlist</string>
    <string name="beta_sheet_avoid_title">Da evitare</string>
    <string name="beta_sheet_avoid_1">Segnalazioni generiche del tipo «Non funziona».</string>
    <string name="beta_sheet_avoid_2">Più problemi non correlati in un\'unica segnalazione.</string>
    <string name="beta_sheet_avoid_3">Log o screenshot non oscurati con dati privati.</string>
    <string name="beta_sheet_privacy_title">Nota sulla privacy</string>
    <string name="beta_sheet_privacy_body">Prima di pubblicare log, screenshot o video, rimuovi le informazioni personali o private.</string>
    <string name="beta_sheet_nightly_title">Build nightly</string>
    <string name="beta_sheet_nightly_summary">In cosa differiscono le nightly dalle versioni di rilascio e cosa includere quando si rompono.</string>
    <string name="beta_sheet_nightly_body">Le build nightly sono generate dall\'ultimo commit e possono contenere modifiche non finite, bug temporanei o regressioni. Sono più sperimentali delle versioni ufficiali.</string>
    <string name="beta_sheet_nightly_access">Le puoi trovare negli artefatti del workflow GitHub Actions del repository, se disponibili.</string>
    <string name="beta_sheet_nightly_report_title">Segnalare problemi delle nightly</string>
    <string name="beta_sheet_nightly_report_body">Quando segnali un problema da una build nightly, indica sempre che si è verificato su una build nightly e non sulla versione ufficiale. Includi la data della build, il nome o numero dell\'esecuzione del workflow, o lo SHA del commit se possibile. Controlla anche se lo stesso problema si verifica sull\'ultima versione ufficiale.</string>
    <string name="beta05_title">Aggiornamento alla beta 0.5.0</string>
    <string name="beta05_clean_install_title">Installazione pulita consigliata</string>
    <string name="beta05_clean_install_body">Se arrivi dalla beta 0.5.0, questo aggiornamento potrebbe richiedere dati della libreria nuovi invece di quelli in cache precedenti.</string>
    <string name="beta05_if_wrong_meta_title">Se i metadati o le voci della libreria sembrano errati</string>
    <string name="beta05_if_wrong_meta_body">Metadati dei brani errati, artisti o album non corrispondenti o voci che sembrano duplicate di solito indicano che la soluzione è un\'installazione pulita.</string>
