    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Velkommen til XiangsuPlayer 0.7.5-beta</string>
    <string name="beta_sheet_welcome_body">Du bruker et beta-bygg som kan inneholde feil, krasj eller eksperimentelle funksjoner. Hjelp oss å bli bedre ved å rapportere problemer.</string>
    <string name="beta_sheet_expect_title">Hva du kan forvente</string>
    <string name="beta_sheet_expect_1">Feil, krasj eller uferdige funksjoner kan oppstå uventet.</string>
    <string name="beta_sheet_expect_2">Noen funksjoner kan endres eller fjernes uten varsel.</string>
    <string name="beta_sheet_expect_3">Beta-bygg kan være mer ustabile enn utgivelsesversjoner.</string>
    <string name="beta_sheet_expect_4">Sjekk alltid for oppdateringer før du rapporterer et kjent problem.</string>
    <string name="beta_sheet_expect_summary">Hva beta-bygg kan endre, ødelegge eller forbedre under testing.</string>
    <string name="beta_sheet_github_title">Snarvei til GitHub-sak</string>
    <string name="beta_sheet_github_body">Søk først, og opprett deretter en målrettet rapport for feil, krasj, ønsker eller spørsmål.</string>
    <string name="beta_sheet_open_issues">Åpne eksisterende saker</string>
    <string name="beta_sheet_report_bug">Rapporter problem eller krasj</string>
    <string name="beta_sheet_report_body">Del trinn for å gjenskape, forventet resultat, faktisk resultat og detaljer om enheten og OS-et ditt.</string>
    <string name="beta_sheet_report_title">Slik rapporterer du</string>
    <string name="beta_sheet_report_summary">En rask sjekkliste før du oppretter en ny sak.</string>
    <string name="beta_sheet_before_title">Før du oppretter en sak</string>
    <string name="beta_sheet_before_1">Søk i eksisterende åpne og lukkede saker for å unngå duplikater.</string>
    <string name="beta_sheet_before_2">Oppdater til nyeste XiangsuPlayer-versjon og bekreft at problemet fortsatt skjer.</string>
    <string name="beta_sheet_before_3">Start appen på nytt og bekreft at problemet vedvarer.</string>
    <string name="beta_sheet_before_4">Prøv å gjenskape det og skriv ned de nøyaktige trinnene.</string>
