<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme - AppCompat (compatible with Android 7+) -->
    <style name="Theme.PixelPlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 与 Compose 的背景色一致（见 @color/pixelplay_background），避免预测返回/启动时闪出另一种底色 -->
        <item name="android:windowBackground">@color/pixelplay_background</item>
    </style>

    <style name="Theme.PixelPlay.ExternalPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- Simple theme for SplashActivity - must be an AppCompat descendant because SplashActivity extends AppCompatActivity -->
    <style name="Theme.PixelPlay.Simple" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- 启动闪屏主题：MainActivity 冷启动时使用，installSplashScreen() 结束后自动切回 postSplashScreenTheme。
         底色用 @color/pixelplay_background（values / values-night 各一份），深浅色自动解析。 -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 底色与 App 背景完全一致：启动画面 → Compose 首帧之间不会出现颜色跳变 -->
        <item name="windowSplashScreenBackground">@color/pixelplay_background</item>
        <!-- 直接不显示启动图标：系统启动画面只留纯色底，不再展示 App logo
             （品牌名称文字改由 MainActivity 的「浮出」文字层呈现，对齐原版 XiangsuPlayer） -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- 图标内部动画时长取极小值：启动图标静态显示，首帧即交棒，避免拉长启动观感 -->
        <item name="windowSplashScreenAnimationDuration">10</item>
        <item name="postSplashScreenTheme">@style/Theme.PixelPlay</item>
    </style>

    <!-- 登录页主题：窗口过渡对齐导航层 AOSP SharedAxis（进入 slide 1/3 + fade，返回滑出全屏），
         与「首页卡片 → 详情页」的导航手感一致；API 34+ 的预测返回由系统提供 -->
    <style name="Theme.PixelPlay.Login">
        <item name="android:windowAnimationStyle">@style/WindowAnimation.Login</item>
    </style>

    <style name="WindowAnimation.Login" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/aosp_slide_next_in</item>
        <item name="android:activityOpenExitAnimation">@anim/aosp_slide_next_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/aosp_slide_back_in</item>
        <item name="android:activityCloseExitAnimation">@anim/aosp_slide_back_out</item>
    </style>
</resources>